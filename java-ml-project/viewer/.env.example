# Copy to .env (gitignored). Used by Vite at build time.
# deploy-local.sh passes this from Terraform output when building.

# Sentiment + reflection API base URL (no trailing slash)
VITE_SENTIMENT_API_URL=https://your-api-id.execute-api.us-west-1.amazonaws.com

# Where to store Research ID + completed-step flags: local (default, survives restarts) or session (clears when tab closes)
# VITE_WORKSHOP_STORAGE=session
