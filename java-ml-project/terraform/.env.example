# Copy to .env and fill in. .env is gitignored.
# run.sh sources .env automatically if present.

# Required for run.sh (terraform)
export AWS_REGION="us-west-1"
export FRONTEND_BUCKET_NAME="java-workshop-yourname-$(date +%s)"
export ENVIRONMENT="prod"
export PROJECT_NAME="java-workshop"

# Optional: Google Sheets for reflection submissions
# 1. Fill service-account.json (same dir)
# 2. Uncomment and set:
# export TF_VAR_google_sheet_id="1abc...xyz"
# export TF_VAR_google_service_account_json="$(cat service-account.json | jq -c .)"
